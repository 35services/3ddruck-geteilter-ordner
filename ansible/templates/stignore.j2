// Managed by Ansible (geteilter-ordner). Only these file types are synced,
// everything else is ignored. (?i) makes the patterns case-insensitive.
// The Menti's folder inside is a Syncthing folder of its own.
/{{ geteilter_ordner_menti_label }}
{% for type in geteilter_ordner_file_types %}
(?i)!*.{{ type }}
{% endfor %}
*
